# =================================================================
# .env.modelo — cola de referencia de TODOS os valores do pack.
#
# Este arquivo NAO e lido automaticamente pelas stacks. Ele e a sua
# "cola": preencha aqui uma vez e copie cada valor para o lugar
# correspondente (placeholders MAIUSCULOS) ao colar cada stack no
# Portainer. NUNCA comite este arquivo preenchido com segredos reais.
#
# Como gerar os segredos (rode no seu PC ou no servidor):
#   MASTER_KEY / BRIDGE_ENCRYPTION_KEY : openssl rand -base64 32
#   SECRET_KEY_BASE (Chatwoot)         : openssl rand -hex 32
#   PBW_ENCRYPTION_KEY (backup)        : openssl rand -base64 16
# =================================================================

# ---------- HOSTNAMES ----------
# Os enderecos COMPLETOS (sem https://) que voce quer para cada painel.
# Voce escolhe livremente; o tunnel cria o CNAME ao adicionar o Public
# Hostname no Zero Trust (passo 5). Ex.: chatwoot.suaempresa.com
#
# IMPORTANTE: use 1 nivel de subdominio (chatwoot.seudominio.com). Dois niveis
# (chat.chatwoot.seudominio.com) quebram o SSL gratis do Cloudflare, que so
# cobre seudominio.com e *.seudominio.com.
CHATWOOT_HOST=
BRIDGE_HOST=
PORTAINER_HOST=
BACKUP_HOST=

# ---------- 02-portainer ----------
# Senha do admin do Portainer (usuario fica 'admin'). Minimo 12 caracteres.
# Pre-criada no boot via --admin-password-file (sem timeout de 5 min).
PORTAINER_PASSWORD=

# ---------- 03-postgres ----------
# Senha do superusuario `postgres`. Usada tambem no Chatwoot,
# no bridge (POSTGRES_ADMIN_URL) e no backup.
SENHA_POSTGRES=

# ---------- 05-chatwoot ----------
# SECRET_KEY_BASE do Chatwoot. openssl rand -hex 32
CHAVE_SECRETA_64=
# (FRONTEND_URL e montado como https://$CHATWOOT_HOST — nada a preencher aqui)

# ---------- 06-bridge-admin ----------
# Login do painel do bridge. openssl rand -base64 32
MASTER_KEY=
# Chave AES que cifra os segredos dos tenants. openssl rand -base64 32
# ATENCAO: nunca troque depois de ter dados reais.
BRIDGE_ENCRYPTION_KEY=
# Senha do role `bridge` no Postgres (voce escolhe uma).
SENHA_BRIDGE=

# ---------- 04-cloudflared ----------
# Token do Cloudflare Tunnel (gerado no painel Zero Trust, passo 5).
# Comeca com algo tipo eyJ...
TOKEN_DO_TUNNEL=

# ---------- 07-backup ----------
# Chave de cifra do pgbackweb. openssl rand -base64 16
PBW_ENCRYPTION_KEY_20=
